#version 450
// Exact PCU F16/BF16/OFP8 arithmetic in bounded U32 significands: no floating instructions,
// device rounding/FTZ/DAZ assumptions, contraction, or host arithmetic fallback.
// IEEE 754-2019 4.3.1 defines nearest ties even and 7.5(a) tininess after precision
// rounding. Finite-input rejection and errors rather than IEEE defaults are PCU policy.
layout(local_size_x=64) in;
layout(constant_id=0) const uint OP = 0; // Add/Sub/Mul/Div = 0/1/2/3.
layout(constant_id=1) const uint POLICY = 0; // IEEE-after/RejectSubnormal/AllowGradual.
layout(constant_id=2) const uint LEFT_SOURCE = 0;
layout(constant_id=3) const uint RIGHT_SOURCE = 1;
// Specialization IDs4/5 describe mathematical operand indices, independent of bank aliasing.
layout(constant_id=4) const uint SOURCE0_BROADCAST = 0;
layout(constant_id=5) const uint SOURCE1_BROADCAST = 0;
layout(constant_id=6) const uint FORMAT = 0; // F16/BF16/E4M3FN/E5M2.
layout(constant_id=7) const uint EXTENT = 1; // Logical lanes; physical descriptors are padded words.
const uint WIDTH = FORMAT < 2 ? 16u : 8u;
const uint FRACTION = FORMAT == 0 ? 10u : FORMAT == 1 ? 7u : FORMAT == 2 ? 3u : 2u;
const int BIAS = FORMAT == 1 ? 127 : FORMAT == 2 ? 7 : 15;
const uint SIGN = 1u << (WIDTH-1);
const uint MAXIMUM = FORMAT == 0 ? 0x7bffu : FORMAT == 1 ? 0x7f7fu : FORMAT == 2 ? 0x7eu : 0x7bu;
const uint FRACTION_MASK = (1u << FRACTION)-1u;
const int MIN_EXPONENT = 1-BIAS;
const int MAX_EXPONENT = int(MAXIMUM >> FRACTION)-BIAS;
const uint LANES = 32u/WIDTH;
layout(set=0,binding=0,std430) readonly buffer Source0 { uint values[]; } source0;
layout(set=0,binding=1,std430) readonly buffer Source1 { uint values[]; } source1;
layout(set=0,binding=2,std430) writeonly buffer Output { uint values[]; } output_data;
layout(set=0,binding=3,std430) writeonly buffer Status { uint values[]; } status_data;
struct Result { uint bits; uint status; };
struct Parts { uint sign; uint significand; int exponent; };
// Range faults retain exact useful payloads in private output. Reject never publishes them;
// a completed Clamp map may publish only after the host has ruled out every fatal lane.
// Diagnostic ABI: 0 success, 1 invalid operand, 2 underflow, 3 overflow, 4 zero divisor.
Result ok(uint bits) { return Result(bits, 0); }
Result fault(uint status) { return Result(0, status); }
Parts decode(uint bits) {
    uint exponent = (bits & (SIGN-1u)) >> FRACTION;
    uint significand = bits & FRACTION_MASK;
    if (exponent != 0) significand |= 1u << FRACTION;
    return Parts(bits >> (WIDTH-1), significand, exponent == 0 ? MIN_EXPONENT : int(exponent)-BIAS);
}
// Every call guards distance before shifting. Zero and >=32 never execute a shift.
// Extended inputs fit <=15 bits; >=32 therefore means zero+sticky in the exact wider oracle.
uint jam(uint value, uint distance) {
    if (distance == 0) return value;
    if (distance >= 32) return uint(value != 0);
    return (value >> distance) | uint((value & ((1u << distance)-1u)) != 0);
}
bool increment(uint significand, uint discarded) {
    return discarded > 4u || (discarded == 4u && (significand & 1u) != 0);
}
Result passthrough(uint bits) {
    uint magnitude = bits & (SIGN-1u);
    if (POLICY == 1 && magnitude != 0 && magnitude < (1u << FRACTION)) return Result(bits, 2);
    return ok(bits);
}
// Precondition ext!=0. With FRACTION<=10, Add supplies <2^15 and normalized
// Mul/Div have top bit FRACTION+3<=13. No U32 carry/normalization overflow.
// Exponents stay within [-298,277], a conservative bound also covering BF16.
Result pack(uint sign, uint ext, int exponent) {
    while (ext >= (1u << (FRACTION+4))) { ext = jam(ext, 1); exponent += 1; }
    while (ext < (1u << (FRACTION+3))) { ext <<= 1; exponent -= 1; }
    uint unbounded_sig = ext >> 3;
    if (increment(unbounded_sig, ext & 7u)) unbounded_sig += 1;
    int unbounded_exp = exponent + int(unbounded_sig == (1u << (FRACTION+1)));
    bool tiny = unbounded_exp < MIN_EXPONENT;
    if (exponent < MIN_EXPONENT) { ext = jam(ext, uint(MIN_EXPONENT-exponent)); exponent = MIN_EXPONENT; }
    uint discarded = ext & 7u;
    uint significand = ext >> 3;
    bool inexact = discarded != 0;
    if (increment(significand, discarded)) significand += 1;
    bool subnormal = false;
    uint bits;
    if (exponent == MIN_EXPONENT && significand < (1u << FRACTION)) {
        bits = (sign << (WIDTH-1)) | significand;
        subnormal = significand != 0;
    } else {
        if (significand >= (1u << (FRACTION+1))) { significand >>= 1; exponent += 1; }
        if (exponent > MAX_EXPONENT) return Result((sign << (WIDTH-1)) | MAXIMUM, 3);
        bits = (sign << (WIDTH-1)) | (uint(exponent+BIAS) << FRACTION) | (significand & FRACTION_MASK);
    }
    // E4M3FN has finite final-exponent encodings through fraction110, then reserved NaN.
    // Check the rounded destination fields explicitly, including the ties-even 464->448 case.
    if ((bits & (SIGN-1u)) > MAXIMUM) return Result((sign << (WIDTH-1)) | MAXIMUM,3);
    bool reject = POLICY == 0 ? (tiny && inexact) : POLICY == 1 ? (subnormal || (tiny && inexact)) : false;
    return reject ? Result(bits, 2) : ok(bits);
}
Result add(uint left, uint right, bool subtract) {
    Parts a = decode(left); Parts b = decode(right); b.sign ^= uint(subtract);
    if (a.significand == 0) {
        if (b.significand != 0) return passthrough((b.sign << (WIDTH-1)) | (right & (SIGN-1u)));
        return ok(uint(a.sign == b.sign) * (a.sign << (WIDTH-1)));
    }
    if (b.significand == 0) return passthrough(left);
    if (a.exponent < b.exponent) { Parts temporary = a; a = b; b = temporary; }
    uint x = a.significand << 3; // Each extended input <2^14, maximum sum <2^15.
    uint y = jam(b.significand << 3, uint(a.exponent-b.exponent));
    uint sign; uint ext;
    if (a.sign == b.sign) { sign = a.sign; ext = x+y; }
    else if (x >= y) { sign = a.sign; ext = x-y; }
    else { sign = b.sign; ext = y-x; }
    return ext == 0 ? ok(0) : pack(sign, ext, a.exponent);
}
Result multiply(uint left, uint right) {
    Parts a = decode(left); Parts b = decode(right);
    uint sign = a.sign ^ b.sign;
    if (a.significand == 0 || b.significand == 0) return ok(sign << (WIDTH-1));
    // Each significand <2^11; umulExtended computes all <=22 product bits exactly.
    uint high; uint low; umulExtended(a.significand, b.significand, high, low);
    int top = high != 0 ? 32+findMSB(high) : findMSB(low); // Product nonzero: top in0..21, high always zero.
    int exponent = a.exponent+b.exponent+top-int(2u*FRACTION);
    uint ext;
    if (top > int(FRACTION+3)) {
        uint distance = uint(top-int(FRACTION+3)); // 1..8: both limb shifts strictly below32.
        ext = (high << (32u-distance)) | (low >> distance);
        ext |= uint((low & ((1u << distance)-1u)) != 0);
    } else {
        ext = low << uint(int(FRACTION+3)-top); // high=0 and resulting top<=13, no overflow.
    }
    return pack(sign, ext, exponent);
}
Result divide(uint left, uint right) {
    Parts a = decode(left); Parts b = decode(right);
    uint sign = (left ^ right) >> (WIDTH-1);
    if (b.significand == 0) return fault(4);
    if (a.significand == 0) return ok(sign << (WIDTH-1));
    uint a_shift = uint(int(FRACTION)-findMSB(a.significand)); // Nonzero shifts0..10.
    uint b_shift = uint(int(FRACTION)-findMSB(b.significand));
    a.significand <<= a_shift; a.exponent -= int(a_shift);
    b.significand <<= b_shift; b.exponent -= int(b_shift);
    uint remainder = a.significand;
    int exponent = a.exponent-b.exponent;
    if (remainder < b.significand) { remainder <<= 1; exponent -= 1; }
    // Exact FRACTION+4-bit quotient, <=14bits. Initial remainder in[d,2*d),
    // d<2^11; after subtract remainder<d, every next shift keeps it<2^12.
    // No integer division, U32 carry or zero-divisor UB participates.
    uint quotient = 0;
    for (uint bit=0; bit<FRACTION+4; bit++) {
        quotient <<= 1;
        if (remainder >= b.significand) { remainder -= b.significand; quotient |= 1; }
        if (bit != FRACTION+3) remainder <<= 1;
    }
    quotient |= uint(remainder != 0);
    return pack(sign, quotient, exponent);
}
// Each invocation owns one entire output word, eliminating packed-byte write races.
// Padding is private, initialized cold and never published to the caller. Input reads
// stay inside padded descriptors; logical status has one independently owned U32/lane.
uint load_bits(uint bank,uint index) {
    uint packed = bank == 0 ? source0.values[index/LANES] : source1.values[index/LANES];
    return (packed >> ((index%LANES)*WIDTH)) & ((SIGN << 1)-1u);
}
void main() {
    uint word = gl_GlobalInvocationID.x;
    // Quotient+remainder ceil avoids EXTENT+LANES-1 overflow, even at U32_MAX.
    uint words = EXTENT/LANES + uint(EXTENT%LANES != 0);
    if (word >= words) return;
    uint packed = 0;
    for (uint lane=0;lane<LANES;lane++) {
        uint index = word*LANES+lane; // Last word base<=EXTENT-1; lane addition fitsU32.
        if (index >= EXTENT) break;
        uint lhs = load_bits(LEFT_SOURCE,SOURCE0_BROADCAST != 0 ? 0u : index);
        uint rhs = load_bits(RIGHT_SOURCE,SOURCE1_BROADCAST != 0 ? 0u : index);
        Result result;
        if ((lhs & (SIGN-1u)) > MAXIMUM || (rhs & (SIGN-1u)) > MAXIMUM) result = fault(1);
        else if (OP == 0) result = add(lhs,rhs,false);
        else if (OP == 1) result = add(lhs,rhs,true);
        else if (OP == 2) result = multiply(lhs,rhs);
        else result = divide(lhs,rhs);
        packed |= result.bits << (lane*WIDTH); // Greatest distance24, always<32.
        status_data.values[index] = result.status;
    }
    output_data.values[word] = packed;
}

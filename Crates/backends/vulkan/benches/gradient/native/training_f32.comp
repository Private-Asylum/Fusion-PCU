#version 450
// Ordered PCU Strict compounds. Scalar integer synthesis is copied exactly from
// the qualified F32 checked binary body; no floating type or native 64-bit integer.
// Each constituent rounds/classifies before the next; no FMA or reassociation.
// Native diagnostics retain fault kind only; this fused valid-value peer does not
// certify the PCU graph node/output-lane/reduction/step fault ordering.
layout(local_size_x=64) in;
const uint POLICY = 0;
layout(set=0,binding=0,std430) readonly buffer Source0 { uint values[]; } source0;
layout(set=0,binding=1,std430) readonly buffer Source1 { uint values[]; } source1;
layout(set=0,binding=2,std430) writeonly buffer Output { uint values[]; } output_data;
layout(set=0,binding=3,std430) writeonly buffer Status { uint values[]; } status_data;
struct Result { uint bits; uint status; };
struct Parts { uint sign; uint significand; int exponent; };
// Range faults retain exact useful payloads in private output. Reject never publishes them;
// a completed Clamp map may publish only after the host has ruled out every fatal lane.
// Diagnostic ABI: 0 success, 1 invalid operand, 2 underflow, 3 overflow, 4 zero divisor.
Result ok(uint bits) { return Result(bits, 0); }
Result fault(uint status) { return Result(0, status); }
Parts decode(uint bits) {
    uint exponent = (bits >> 23) & 255u;
    uint significand = bits & 0x7fffffu;
    if (exponent != 0) significand |= 0x800000u;
    return Parts(bits >> 31, significand, exponent == 0 ? -126 : int(exponent)-127);
}
// Every call guards distance before shifting. Zero and >=32 never execute a shift.
// Values jammed here fit <=28 bits; hence >=32 equals the wider core oracle's zero+sticky.
uint jam(uint value, uint distance) {
    if (distance == 0) return value;
    if (distance >= 32) return uint(value != 0);
    return (value >> distance) | uint((value & ((1u << distance)-1u)) != 0);
}
bool increment(uint significand, uint discarded) {
    return discarded > 4u || (discarded == 4u && (significand & 1u) != 0);
}
Result passthrough(uint bits) {
    uint magnitude = bits & 0x7fffffffu;
    if (POLICY == 1 && magnitude != 0 && magnitude < 0x800000u) return Result(bits, 2);
    return ok(bits);
}
// Precondition ext!=0. Add supplies <2^28; Mul/Div supply normalized <2^27.
// Left normalization stops at bit26, so shifts/additions never overflow a U32.
// Exponents remain in [-298,277], including gradual packing; I32 never overflows.
Result pack(uint sign, uint ext, int exponent) {
    while (ext >= (1u << 27)) { ext = jam(ext, 1); exponent += 1; }
    while (ext < (1u << 26)) { ext <<= 1; exponent -= 1; }
    uint unbounded_sig = ext >> 3;
    if (increment(unbounded_sig, ext & 7u)) unbounded_sig += 1;
    int unbounded_exp = exponent + int(unbounded_sig == (1u << 24));
    bool tiny = unbounded_exp < -126;
    if (exponent < -126) { ext = jam(ext, uint(-126-exponent)); exponent = -126; }
    uint discarded = ext & 7u;
    uint significand = ext >> 3;
    bool inexact = discarded != 0;
    if (increment(significand, discarded)) significand += 1;
    bool subnormal = false;
    uint bits;
    if (exponent == -126 && significand < 0x800000u) {
        bits = (sign << 31) | significand;
        subnormal = significand != 0;
    } else {
        if (significand >= (1u << 24)) { significand >>= 1; exponent += 1; }
        if (exponent > 127) return Result((sign << 31) | 0x7f7fffffu, 3);
        bits = (sign << 31) | (uint(exponent+127) << 23) | (significand & 0x7fffffu);
    }
    bool reject = POLICY == 0 ? (tiny && inexact) : POLICY == 1 ? (subnormal || (tiny && inexact)) : false;
    return reject ? Result(bits, 2) : ok(bits);
}
Result add(uint left, uint right, bool subtract) {
    Parts a = decode(left); Parts b = decode(right); b.sign ^= uint(subtract);
    if (a.significand == 0) {
        if (b.significand != 0) return passthrough((b.sign << 31) | (right & 0x7fffffffu));
        return ok(uint(a.sign == b.sign) * (a.sign << 31));
    }
    if (b.significand == 0) return passthrough(left);
    if (a.exponent < b.exponent) { Parts temporary = a; a = b; b = temporary; }
    uint x = a.significand << 3; // <2^27, maximum sum of both extended inputs <2^28.
    uint y = jam(b.significand << 3, uint(a.exponent-b.exponent));
    uint sign; uint ext;
    if (a.sign == b.sign) { sign = a.sign; ext = x+y; }
    else if (x >= y) { sign = a.sign; ext = x-y; }
    else { sign = b.sign; ext = y-x; }
    return ext == 0 ? ok(0) : pack(sign, ext, a.exponent);
}
Result multiply(uint left, uint right) {
    Parts a = decode(left); Parts b = decode(right);
    uint sign = a.sign ^ b.sign;
    if (a.significand == 0 || b.significand == 0) return ok(sign << 31);
    // Each significand <2^24; umulExtended computes all <=48 product bits exactly.
    uint high; uint low; umulExtended(a.significand, b.significand, high, low);
    int top = high != 0 ? 32+findMSB(high) : findMSB(low); // product nonzero: top in0..47.
    int exponent = a.exponent+b.exponent+top-46;
    uint ext;
    if (top > 26) {
        uint distance = uint(top-26); // 1..21: both limb shifts are strictly below32.
        ext = (high << (32u-distance)) | (low >> distance);
        ext |= uint((low & ((1u << distance)-1u)) != 0);
    } else {
        ext = low << uint(26-top); // high=0 and resulting top=26, never overflows.
    }
    return pack(sign, ext, exponent);
}
Result divide(uint left, uint right) {
    Parts a = decode(left); Parts b = decode(right);
    uint sign = (left ^ right) >> 31;
    if (b.significand == 0) return fault(4);
    if (a.significand == 0) return ok(sign << 31);
    uint a_shift = uint(23-findMSB(a.significand)); // both nonzero significands: 0..23.
    uint b_shift = uint(23-findMSB(b.significand));
    a.significand <<= a_shift; a.exponent -= int(a_shift);
    b.significand <<= b_shift; b.exponent -= int(b_shift);
    uint remainder = a.significand;
    int exponent = a.exponent-b.exponent;
    if (remainder < b.significand) { remainder <<= 1; exponent -= 1; }
    // Exact quotient of (normalized numerator<<26)/denominator, without 64-bit division.
    // Numerator starts in[d,2*d), d<2^24. After subtraction remainder<d; each next
    // shift keeps remainder<2^25. Quotient has exactly27 bits; no U32 overflow/zero divide.
    uint quotient = 0;
    for (uint bit=0; bit<27; bit++) {
        quotient <<= 1;
        if (remainder >= b.significand) { remainder -= b.significand; quotient |= 1; }
        if (bit != 26) remainder <<= 1;
    }
    quotient |= uint(remainder != 0);
    return pack(sign, quotient, exponent);
}

bool finite(uint a) { return ((a >> 23)&255u) != 255u; }
Result checked(uint a,uint b,uint operation) {
 if (!finite(a)||!finite(b)) return fault(1);
 if (operation==0) return add(a,b,false);
 if (operation==1) return add(a,b,true);
 if (operation==2) return multiply(a,b);
 return divide(a,b);
}
// Independent fused native control for the fixed 2x2 forward/loss/weight-gradient/update workload.
// Both source banks stay in one logical context. Only invocation0 writes two complete logical lanes.
// Every scalar constituent uses the qualified integer arithmetic body; forward MSE is checked
// even though only updated weights escape. No reference/backend evaluation or generated PCU IR.
bool positive(uint a){return (a&0x80000000u)==0u && (a&0x7fffffffu)!=0u;}
bool tiny(uint a){return (a&0x7f800000u)==0u && (a&0x007fffffu)!=0u;}
bool failed(Result r){if(r.status==0u)return false;status_data.values[0]=r.status;return true;}
Result unary(uint operand, uint upstream, bool backward){
 if(!finite(operand)||!finite(upstream))return fault(1u);
 uint value=positive(operand)?(backward?upstream:operand):0u;
 if(POLICY==1u && tiny(value))return fault(2u);
 return ok(value);
}
void main(){
 if(gl_GlobalInvocationID.x!=0u)return;
 status_data.values[0]=0u;status_data.values[1]=0u;
 uint pre[2];uint prediction[2];uint upstream[2];uint gradient[2];
 for(uint row=0u;row<2u;row++){
  uint total=0u;
  for(uint inner=0u;inner<2u;inner++){
   Result p=checked(source0.values[row*2u+inner],source1.values[inner],2u);if(failed(p))return;
   Result s=checked(total,p.bits,0u);if(failed(s))return;total=s.bits;
  }
  pre[row]=total;Result r=unary(total,0u,false);if(failed(r))return;prediction[row]=r.bits;
 }
 uint sum=0u;
 for(uint row=0u;row<2u;row++){
  Result d=checked(prediction[row],source0.values[4u+row],1u);if(failed(d))return;
  Result p=checked(d.bits,d.bits,2u);if(failed(p))return;
  Result s=checked(sum,p.bits,0u);if(failed(s))return;sum=s.bits;
 }
 Result mean=checked(sum,0x40000000u,3u);if(failed(mean))return;
 // 2/n is exactly1 for n=2; retain the checked multiplication and separate Sub.
 for(uint row=0u;row<2u;row++){
  Result d=checked(prediction[row],source0.values[4u+row],1u);if(failed(d))return;
  Result p=checked(d.bits,0x3f800000u,2u);if(failed(p))return;
  Result r=unary(pre[row],p.bits,true);if(failed(r))return;upstream[row]=r.bits;
 }
 for(uint column=0u;column<2u;column++){
  uint total=0u;
  for(uint row=0u;row<2u;row++){
   Result p=checked(source0.values[row*2u+column],upstream[row],2u);if(failed(p))return;
   Result s=checked(total,p.bits,0u);if(failed(s))return;total=s.bits;
  }
  gradient[column]=total;
 }
 for(uint column=0u;column<2u;column++){
  Result p=checked(0x3f000000u,gradient[column],2u);if(failed(p))return;
  Result s=checked(source1.values[column],p.bits,1u);if(failed(s))return;
  output_data.values[column]=s.bits;
 }
}
